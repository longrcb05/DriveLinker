GET http://localhost:8080/api/dashboard/vehicles/1/journey?from=2026-10-01T00:00:00&to=2026-10-31T23:59:59
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzM4NCJ9.eyJvcmdhbml6YXRpb25JZCI6MSwicm9sZSI6IkFETUlOIiwic3ViIjoiYWRtaW4iLCJpYXQiOjE3OTE0NDE5MzMsImV4cCI6MTc5MTUyODMzM30.mrCR_muJd0UyXvcY5eANzCm-P-DxagnlnzaX96iKmi7qtR0AUiPMw2kkkfhNYa2g
